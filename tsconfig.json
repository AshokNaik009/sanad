{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2024", "ESNext.Collection", "DOM"]
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
