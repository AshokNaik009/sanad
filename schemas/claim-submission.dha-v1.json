{
  "$comment": "Structural schema for the DHA eClaimLink Claim.Submission transaction as modelled for the Sanad hackathon MVP. Pinned here so generation and mock-gateway validation agree. Replace with the current published DHA/DOH XSD before any pilot.",
  "version": "dha-claim-submission-v1-demo",
  "root": "Claim.Submission",
  "elements": {
    "Claim.Submission": { "children": { "Header": [1, 1], "Claim": [1, 1000] } },
    "Header": {
      "children": {
        "SenderID": [1, 1],
        "ReceiverID": [1, 1],
        "TransactionDate": [1, 1],
        "RecordCount": [1, 1],
        "DispositionFlag": [1, 1]
      }
    },
    "SenderID": { "type": "string", "pattern": "^[A-Z0-9-]{3,30}$" },
    "ReceiverID": { "type": "string", "pattern": "^[A-Z0-9-]{3,30}$" },
    "TransactionDate": { "type": "dhaDate" },
    "RecordCount": { "type": "integer", "min": 1 },
    "DispositionFlag": { "type": "enum", "values": ["PRODUCTION", "TEST DATA"] },
    "Claim": {
      "children": {
        "ID": [1, 1],
        "IDPayer": [0, 1],
        "MemberID": [1, 1],
        "PayerID": [1, 1],
        "ProviderID": [1, 1],
        "EmiratesIDNumber": [1, 1],
        "Gross": [1, 1],
        "PatientShare": [1, 1],
        "Net": [1, 1],
        "Encounter": [1, 1],
        "Diagnosis": [1, 30],
        "Activity": [1, 100],
        "Resubmission": [0, 1]
      }
    },
    "ID": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "IDPayer": { "type": "string" },
    "MemberID": { "type": "string", "pattern": "^[A-Z0-9-]{4,30}$" },
    "PayerID": { "type": "string", "pattern": "^[A-Z0-9-]{3,30}$" },
    "ProviderID": { "type": "string", "pattern": "^[A-Z0-9-]{3,30}$" },
    "EmiratesIDNumber": { "type": "string", "pattern": "^784-\\d{4}-\\d{7}-\\d$" },
    "Gross": { "type": "decimal", "min": 0 },
    "PatientShare": { "type": "decimal", "min": 0 },
    "Net": { "type": "decimal", "min": 0 },
    "Encounter": {
      "children": {
        "FacilityID": [1, 1],
        "Type": [1, 1],
        "PatientID": [1, 1],
        "Start": [1, 1],
        "End": [0, 1],
        "StartType": [0, 1],
        "EndType": [0, 1]
      }
    },
    "FacilityID": { "type": "string", "pattern": "^[A-Z0-9-]{3,30}$" },
    "Encounter.Type": { "type": "enum", "values": ["1", "3", "4"], "$comment": "1 outpatient (no bed), 3 day case, 4 emergency" },
    "PatientID": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "Start": { "type": "dhaDate" },
    "End": { "type": "dhaDate" },
    "StartType": { "type": "integer" },
    "EndType": { "type": "integer" },
    "Diagnosis": { "children": { "Type": [1, 1], "Code": [1, 1] } },
    "Diagnosis.Type": { "type": "enum", "values": ["Principal", "Secondary", "Admitting"] },
    "Code": { "type": "string", "pattern": "^[A-Z0-9.-]{2,20}$" },
    "Activity": {
      "children": {
        "ID": [1, 1],
        "Start": [1, 1],
        "Type": [1, 1],
        "Code": [1, 1],
        "Quantity": [1, 1],
        "Net": [1, 1],
        "Clinician": [1, 1],
        "PriorAuthorizationID": [0, 1]
      }
    },
    "Activity.Type": { "type": "enum", "values": ["3", "4", "5", "6", "8"], "$comment": "3 CPT, 4 HCPCS, 5 Drug, 6 Dental, 8 Service code" },
    "Quantity": { "type": "decimal", "min": 0.01 },
    "Clinician": { "type": "string", "pattern": "^[A-Z0-9-]{4,30}$" },
    "PriorAuthorizationID": { "type": "string", "pattern": "^[A-Z0-9-]{4,40}$" },
    "Resubmission": { "children": { "Type": [1, 1], "Comment": [1, 1], "Attachment": [0, 1] } },
    "Resubmission.Type": { "type": "enum", "values": ["correction", "internal complaint", "legacy", "reconciliation"] },
    "Comment": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "Attachment": { "type": "string" }
  }
}
