# Copy to .env. All data is synthetic; never load real patient data into a demo.
PORT=8788
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8788
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Leave unset to use embedded Postgres (PGlite) under DATA_DIR.
# Supabase: Project Settings -> Database -> Connection string (URI). Sanad creates and uses
# its own `sanad` schema, which Supabase's REST Data API does not expose.
# If the direct host (db.<ref>.supabase.co) fails on an IPv4-only network, use the Session
# pooler URI (aws-0-<region>.pooler.supabase.com:5432) instead.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATA_DIR=.sanad

# Optional shared bearer key in front of the API.
# SANAD_ACCESS_KEY=

# AI engine: "sample" (offline, deterministic) or "model" (live provider chain below).
AI_MODE=sample
# Providers are tried in order; any failure falls through to the next, then to the offline engine.
LLM_PROVIDERS=groq,openrouter
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3
# OPENROUTER_PROVIDER_ORDER=GMICloud
# OCR for scanned notes uses a separate vision chain, same provider order, one model after another:
# GROQ_VISION_MODELS=qwen/qwen3.8-27b
# OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Optional Claude provider (add "anthropic" to LLM_PROVIDERS):
# ANTHROPIC_API_KEY=
# SANAD_MODEL=claude-opus-5

# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# SANAD_ENCRYPTION_KEY=

# Gateway: leave unset to use the built-in mock DHA/DOH gateway.
# GATEWAY_URL=
ADJUDICATION_DELAY_SECONDS=6
UNDERPAYMENT_THRESHOLD_AED=5
TASK_WORKER_ENABLED=true
